# API / servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Banco de dados MySQL (preparação para a camada de persistência)
DATABASE_URL=mysql://motor_vtt:change-me@localhost:3306/motor_vtt
DB_HOST=localhost
DB_PORT=3306
DB_USER=motor_vtt
DB_PASS=change-me
DB_NAME=motor_vtt

# Autenticação e segurança
# Use valores aleatórios com pelo menos 32 caracteres em ambientes reais.
JWT_SECRET=replace-with-a-random-32-character-secret
JWT_EXPIRES_IN=1d
COOKIE_SECRET=replace-with-a-random-32-character-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# E-mail (preenchido quando SMTP for habilitado)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# Filas / mensageria
REDIS_URL=redis://localhost:6379

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
